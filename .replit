run = "cd frontend && npm run dev -- -H 0.0.0.0 -p 3000"

entrypoint = "frontend/src/app/page.tsx"

[nix]
channel = "stable-24.05"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
run = ["sh", "-c", "cd frontend && npm run build && npm run start -- -H 0.0.0.0 -p 3000"]
